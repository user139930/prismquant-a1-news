# 複製成 .env 後填入自己的設定；不要提交真實 key

# 大模型（OpenRouter，OpenAI 相容介面）。key 在 https://openrouter.ai/keys
PQ_LLM_API_KEY=sk-or-v1-你的key
PQ_LLM_MODEL=deepseek/deepseek-chat
PQ_LLM_BASE_URL=https://openrouter.ai/api/v1

# 服務
PQ_HOST=127.0.0.1
PQ_PORT=8010
# 允許的跨域來源（JSON 陣列字串），例如 '["http://localhost:5173"]'
# PQ_CORS_ORIGINS=[]

# 資料庫（SQLite，檔案名）
PQ_DB_PATH=news.sqlite3
